<Project>
  <ItemGroup>
    <None Pack="true" PackagePath="analyzers/dotnet/cs" Include="@(Reference)" /> <!-- #:include 등 dll 참조추가 지원. Microsoft.NET.Sdk보다 선행되어야 시스템dll과 분리됨 -->
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <ItemGroup>
    <PackageReference PrivateAssets="all" Version="5.3.0" Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference PrivateAssets="all" Version="1.16.0" Include="PolySharp">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <!-- 닷넷 스탠다드에서 csharp 14 까지의 일부 문법을 사용할수 있도록 지원합니다. -->
    </PackageReference>
  </ItemGroup>
</Project>