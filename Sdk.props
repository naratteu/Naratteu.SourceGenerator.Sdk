<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent> <!-- 디버깅 지원 https://forum.dotnetdev.kr/t/net-6-slog/2210/18 -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules> <!--RS1036-->
    <EnablePackageValidation>true</EnablePackageValidation> <!-- https://learn.microsoft.com/dotnet/fundamentals/apicompat/package-validation/overview -->
    <PackageType>Analyzer</PackageType>
    <LangVersion>14</LangVersion>

    <!-- 분석기가 참조하는 Roslyn 버전은 '쓰는 사람의 컴파일러에 요구하는 최소 버전'이 된다.
         더 높은 Roslyn 을 참조하면 그보다 낮은 컴파일러가 CS9057 로 분석기를 통째로 건너뛴다.
         그래서 분석기는 버틸 수 있는 가장 낮은 Roslyn 을 참조하는 쪽이 맞다.
           4.8  → .NET 8 SDK 이상
           4.14 → .NET 9 SDK(9.0.3xx) 이상
           5.3  → .NET 10 SDK 이상
         Roslyn 5 의 API 가 필요하면 프로젝트에서 <RoslynVersion>5.3.0</RoslynVersion> 으로 올린다. -->
    <RoslynVersion Condition="'$(RoslynVersion)' == ''">4.8.0</RoslynVersion>

    <!-- 생성기 dll 을 analyzers/dotnet/cs 바로 아래 둔다.
         BuildOutputTargetFolder 를 쓰면 그 아래 TFM 폴더(netstandard2.0/)가 한 겹 더 생겨서,
         @(Reference) 로 끼워넣은 dll 들과 디렉터리가 어긋난다. Roslyn 5 는 그래도 찾아내지만
         4.x 는 참조 dll 을 못 찾고 FileNotFoundException 을 던진다. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>
  <PropertyGroup Label="For FBA">
    <OutputType>Library</OutputType>
    <PackAsTool>false</PackAsTool>
    <PublishAot>false</PublishAot>
  </PropertyGroup>
</Project>
